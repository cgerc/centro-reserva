// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sede {
  id                   String      @id @default(cuid())
  nombre               String
  direccion            String?
  
  // Configuración de Google Calendar por Sede
  googleEmail          String?     // El correo de la cuenta de Google vinculada
  googleAccessToken    String?     @db.Text
  googleRefreshToken   String?     @db.Text
  googleTokenExpiry    BigInt?     // Fecha de expiración del token
  googleCalendarId     String?     @default("primary")

  // Relaciones
  psicologos           Psicologo[]
  boxes                Box[]
  citas                Cita[]
  
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Box {
  id        String   @id @default(cuid())
  nombre    String   // Ej: "Box 101", "Sala de Terapia 1"
  sedeId    String
  sede      Sede     @relation(fields: [sedeId], references: [id])
  citas     Cita[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Psicologo {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  sedeId    String
  sede      Sede     @relation(fields: [sedeId], references: [id])
  citas     Cita[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cita {
  id              String   @id @default(cuid())
  pacienteNombre  String
  fechaInicio     DateTime
  fechaFin        DateTime
  googleEventId   String?  // Para poder editar o borrar el evento en Google luego
  
  // Relaciones
  sedeId          String
  sede            Sede     @relation(fields: [sedeId], references: [id])
  psicologoId     String
  psicologo       Psicologo @relation(fields: [psicologoId], references: [id])
  boxId           String?
  box             Box?     @relation(fields: [boxId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}